{
  "name": "qward-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "QPU Benchmark experiment explorer for QWARD (static, deployed to GitHub Pages).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "data": "python3 build.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8774",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
